{
  "name": "predixalearn-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/ocr-studio",
    "apps/institution-server"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:sync": "python apps/ocr-studio/scripts/sync_brand_assets.py",
    "assets:verify": "npm run --workspace @predixalearn/ocr-studio verify:assets",
    "vendor": "npm run --workspace @predixalearn/ocr-studio vendor",
    "typecheck": "npm run --workspace @predixalearn/ocr-studio typecheck",
    "test:ocr": "npm run --workspace @predixalearn/ocr-studio test:ui",
    "typecheck:institution": "npm run --workspace @predixalearn/institution-server typecheck",
    "test:institution-ui": "npm run --workspace @predixalearn/institution-server test:ui"
  }
}
