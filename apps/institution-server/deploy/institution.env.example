PREDIXALEARN_PUBLIC_BASE_URL=https://predixalearn.example.edu
PREDIXALEARN_AUTH_MODE=oidc
PREDIXALEARN_OIDC_ISSUER=https://idp.example.edu
PREDIXALEARN_OIDC_AUDIENCE=predixalearn-api
PREDIXALEARN_OIDC_JWKS_URL=https://idp.example.edu/.well-known/jwks.json
PREDIXALEARN_OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.edu/oauth2/authorize
PREDIXALEARN_OIDC_TOKEN_ENDPOINT=https://idp.example.edu/oauth2/token
PREDIXALEARN_OIDC_CLIENT_ID=replace-me
PREDIXALEARN_OIDC_CLIENT_SECRET=replace-through-secret-manager
PREDIXALEARN_SESSION_SECRET=replace-with-32-plus-random-bytes
PREDIXALEARN_WORKER_SIGNING_KEY=replace-with-base64-ed25519-seed
PREDIXALEARN_WEBHOOK_SIGNING_SECRET=replace-with-32-plus-random-bytes
PREDIXALEARN_API_TOKEN_SECRET=replace-with-a-separate-32-plus-random-byte-secret
PREDIXALEARN_SEMANTIC_SEARCH=false
PREDIXALEARN_FEATURES=archive_review,curriculum,answer_scripts,accessibility,datasets,workers,integrations,lti
PREDIXALEARN_IDENTITY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-secret
PREDIXALEARN_EXTERNAL_AI=false
# Required only when external AI is explicitly enabled:
# PREDIXALEARN_ACCESSIBILITY_AI_ENDPOINT=https://ai.example.edu/v1/accessibility
# PREDIXALEARN_ACCESSIBILITY_AI_TOKEN=replace-through-secret-manager
